                                "port": {"number": 8080},
                            },
                        },
                    }],
                },
            }],
        },
    },
]

for resource in oidc_resources:
    k8s_yaml(encode_yaml(resource))

k8s_resource(
    "oidc-example",
    port_forwards=["8080:8080"],
)

local_resource(
    "mas-google-oidc-env-check",
    cmd="test -n \"$GOOGLE_OIDC_CLIENT_ID\" && test -n \"$GOOGLE_OIDC_CLIENT_SECRET\"",
    env={
        "GOOGLE_OIDC_CLIENT_ID": google_client_id,
        "GOOGLE_OIDC_CLIENT_SECRET": google_client_secret,
    },
    deps=[".env"],
)

k8s_custom_deploy(
    "mas-google-oidc",
    apply_cmd="bash mas-overlay.sh apply",
    delete_cmd="bash mas-overlay.sh delete",
    deps=["mas-overlay.sh", ".env"],
    apply_env={
        "OIDC_EXAMPLE_NAMESPACE": namespace,
        "GOOGLE_OIDC_CLIENT_ID": google_client_id,
        "GOOGLE_OIDC_CLIENT_SECRET": google_client_secret,
        "MAS_GOOGLE_PROVIDER_ID": mas_google_provider_id,
        "MAS_GOOGLE_PROVIDER_NAME": mas_google_provider_name,
        "MAS_PUBLIC_BASE_URL": mas_public_base_url,
        "MAS_OAUTH_CLIENT_ID": mas_oauth_client_id,
        "MAS_OAUTH_CLIENT_SECRET": mas_oauth_client_secret,
        "OIDC_EXAMPLE_PUBLIC_BASE_URL": public_base_url,
    },
    delete_env={
        "OIDC_EXAMPLE_NAMESPACE": namespace,
    },
)

k8s_resource(
    "mas-google-oidc",
    resource_deps=["oidc-example", "mas-google-oidc-env-check"],
)

local_resource(
    "mas-google-oidc-note",
    cmd="printf 'MAS OIDC overlay is reversible; tilt down restores the saved MAS config.\\n'",
    env={
        "OIDC_EXAMPLE_NAMESPACE": namespace,
        "GOOGLE_OIDC_CLIENT_ID": google_client_id,
        "GOOGLE_OIDC_CLIENT_SECRET": google_client_secret,
        "MAS_GOOGLE_PROVIDER_ID": mas_google_provider_id,
        "MAS_GOOGLE_PROVIDER_NAME": mas_google_provider_name,
        "MAS_PUBLIC_BASE_URL": mas_public_base_url,
        "MAS_OAUTH_CLIENT_ID": mas_oauth_client_id,
        "MAS_OAUTH_CLIENT_SECRET": mas_oauth_client_secret,
        "OIDC_EXAMPLE_PUBLIC_BASE_URL": public_base_url,
    },
    resource_deps=["mas-google-oidc"],
)

local_resource(
    "mas-localhost-forward",
    serve_cmd="kubectl -n ingress-nginx port-forward svc/ingress-nginx-controller 8443:443",
)
