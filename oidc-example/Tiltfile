        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
            "name": "oidc-example",
            "namespace": namespace,
        },
        "type": "Opaque",
        "stringData": {
            "COOKIE_SECRET": cookie_secret,
            "MAS_OAUTH_CLIENT_SECRET": mas_oauth_client_secret,
