    },
    {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
            "name": "oidc-example",
            "namespace": namespace,
            "labels": {"app.kubernetes.io/name": "oidc-example"},
        },
        "spec": {
            "replicas": 1,
            "selector": {"matchLabels": {"app.kubernetes.io/name": "oidc-example"}},
            "template": {
                "metadata": {"labels": {"app.kubernetes.io/name": "oidc-example"}},
                "spec": {
                    "containers": [{
                        "name": "oidc-example",
                        "image": image,
                        "ports": [{"name": "http", "containerPort": 8080}],
                        "env": [
                            {"name": "PORT", "value": "8080"},
                            {"name": "PUBLIC_BASE_URL", "value": public_base_url},
                            {"name": "COOKIE_SECRET", "valueFrom": {"secretKeyRef": {"name": "oidc-example", "key": "COOKIE_SECRET"}}},
                            {"name": "MAS_PUBLIC_BASE_URL", "value": mas_public_base_url},
                            {"name": "MAS_INTERNAL_BASE_URL", "value": mas_internal_base_url},
                            {"name": "MAS_OAUTH_CLIENT_ID", "value": mas_oauth_client_id},
                            {"name": "MAS_OAUTH_CLIENT_SECRET", "valueFrom": {"secretKeyRef": {"name": "oidc-example", "key": "MAS_OAUTH_CLIENT_SECRET"}}},
                            {"name": "MAS_OAUTH_SCOPE", "value": mas_oauth_scope},
                            {"name": "MATRIX_HOMESERVER_INTERNAL_URL", "value": matrix_homeserver_internal_url},
                        ],
                        "readinessProbe": {"httpGet": {"path": "/healthz", "port": "http"}},
                        "livenessProbe": {"httpGet": {"path": "/healthz", "port": "http"}},
                        "resources": {
                            "requests": {"cpu": "25m", "memory": "64Mi"},
                            "limits": {"memory": "128Mi"},
                        },
                    }],
                },
            },
        },
    },
    {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
            "name": "oidc-example",
            "namespace": namespace,
            "labels": {"app.kubernetes.io/name": "oidc-example"},
        },
        "spec": {
            "type": "ClusterIP",
            "selector": {"app.kubernetes.io/name": "oidc-example"},
            "ports": [{"name": "http", "port": 80, "targetPort": "http"}],
        },
    },
    {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "Ingress",
        "metadata": {
            "name": "oidc-example",
            "namespace": namespace,
            "annotations": {
                "cert-manager.io/cluster-issuer": "ess-selfsigned",
            },
        },
        "spec": {
            "ingressClassName": "nginx",
            "tls": [{
                "hosts": ["oidc.ess.localhost"],
                "secretName": "oidc-example-tls",
            }],
            "rules": [{
                "host": "oidc.ess.localhost",
                "http": {
                    "paths": [{
                        "path": "/",
                        "pathType": "Prefix",
                        "backend": {
                            "service": {
                                "name": "oidc-example",
                                "port": {"name": "http"},
                            },
                        },
                    }],
                },
            }],
        },
    },
    {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "Ingress",
        "metadata": {
            "name": "mas-localhost",
            "namespace": namespace,
            "annotations": {
                "cert-manager.io/cluster-issuer": "ess-selfsigned",
            },
        },
        "spec": {
            "ingressClassName": "nginx",
            "tls": [{
                "hosts": ["localhost"],
                "secretName": "mas-localhost-tls",
            }],
            "rules": [{
                "host": "localhost",
                "http": {
                    "paths": [{
