def parse_dotenv(path):
    values = {}
    content = str(read_file(path, default = ""))
    for raw_line in content.splitlines():
        line = raw_line.strip()
        if line == "" or line.startswith("#"):
            continue

        if line.startswith("export "):
            line = line[len("export "):].strip()

        parts = line.split("=", 1)
        if len(parts) != 2:
            continue

        key = parts[0].strip()
        value = parts[1].strip()
        if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
            value = value[1:-1]

        values[key] = value

    return values

dotenv = parse_dotenv(".env")

def env(name, default = ""):
    value = os.getenv(name, "")
    if value != "":
        return value
    return dotenv.get(name, default)

namespace = env("OIDC_EXAMPLE_NAMESPACE", "ess")
image = env("OIDC_EXAMPLE_IMAGE", "oidc-example")
public_base_url = env("OIDC_EXAMPLE_PUBLIC_BASE_URL", "https://oidc.ess.localhost")
google_client_id = env("GOOGLE_OIDC_CLIENT_ID")
google_client_secret = env("GOOGLE_OIDC_CLIENT_SECRET")
cookie_secret = env("OIDC_EXAMPLE_COOKIE_SECRET", "dev-cookie-secret-change-me")
mas_public_base_url = env("MAS_PUBLIC_BASE_URL", "https://localhost:8443")
mas_internal_base_url = env("MAS_INTERNAL_BASE_URL", "http://ess-matrix-authentication-service:8080")
mas_google_provider_id = env("MAS_GOOGLE_PROVIDER_ID", "01HFS6S2SVAR7Y7QYMZJ53ZAGZ")
mas_google_provider_name = env("MAS_GOOGLE_PROVIDER_NAME", "Google")
mas_oauth_client_id = env("MAS_OAUTH_CLIENT_ID", "01J44RKQYM4G3TNVANTMTDYTX6")
mas_oauth_client_secret = env("MAS_OAUTH_CLIENT_SECRET", "dev-mas-oauth-client-secret-change-me")
mas_oauth_scope = env("MAS_OAUTH_SCOPE", "openid urn:matrix:org.matrix.msc2967.client:api:*")
matrix_homeserver_internal_url = env("MATRIX_HOMESERVER_INTERNAL_URL", "http://ess-synapse-main:8008")

if google_client_id == "" or google_client_secret == "":
    fail("Set GOOGLE_OIDC_CLIENT_ID and GOOGLE_OIDC_CLIENT_SECRET in .env before running tilt up.")

docker_build(
    image,
    ".",
)

oidc_resources = [
