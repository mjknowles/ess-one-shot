# Copy this file to `.env`, fill in the Google values, then run `tilt up`
# from this directory. Shell environment variables still win over `.env`.

# Required: Google OAuth client created in Google Cloud Console.
# MAS is the Google OIDC relying party, so Google only needs the MAS callback URI:
#   https://localhost:8443/upstream/callback/01HFS6S2SVAR7Y7QYMZJ53ZAGZ
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Local app deployment defaults.
OIDC_EXAMPLE_PUBLIC_BASE_URL=https://oidc.ess.localhost
OIDC_EXAMPLE_NAMESPACE=ess
OIDC_EXAMPLE_IMAGE=oidc-example

# MAS upstream Google provider. Keep this provider id stable once users have
# linked accounts; changing it makes MAS treat Google identities as a different
# upstream provider.
MAS_GOOGLE_PROVIDER_ID=01HFS6S2SVAR7Y7QYMZJ53ZAGZ
MAS_GOOGLE_PROVIDER_NAME=Google

# oidc-example is a confidential MAS OAuth client. MAS redirects back to:
#   https://oidc.ess.localhost/callback
MAS_OAUTH_CLIENT_ID=01J44RKQYM4G3TNVANTMTDYTX6
MAS_OAUTH_CLIENT_SECRET=dev-mas-oauth-client-secret-change-me

# This scope is what makes the returned MAS token usable against Synapse's
# Matrix Client-Server API. Use only `openid` if you only need identity claims
# and do not need Matrix API calls.
MAS_OAUTH_SCOPE="openid urn:matrix:org.matrix.msc2967.client:api:*"

# Local MAS/Synapse endpoints for this kind-based POC.
MAS_PUBLIC_BASE_URL=https://localhost:8443
MAS_INTERNAL_BASE_URL=http://ess-matrix-authentication-service:8080
MATRIX_HOMESERVER_INTERNAL_URL=http://ess-synapse-main:8008
