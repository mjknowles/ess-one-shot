# Copy this file to `.env`, then run `tilt up` from this directory.
# Shell environment variables still win over values in `.env`.
#
# In Google Cloud Console, create an OAuth 2.0 Client ID of type "Web application".
# MAS is the Google OIDC relying party, so Google only needs the MAS callback URI:
#   https://account.ess.localhost/upstream/callback/01HFS6S2SVAR7Y7QYMZJ53ZAGZ
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# These defaults match the local ESS kind deployment.
OIDC_EXAMPLE_PUBLIC_BASE_URL=https://oidc.ess.localhost
OIDC_EXAMPLE_NAMESPACE=ess
OIDC_EXAMPLE_IMAGE=oidc-example

# MAS uses a stable provider id. If you change it after users link accounts,
# MAS will treat the provider identities as a different upstream provider.
MAS_GOOGLE_PROVIDER_ID=01HFS6S2SVAR7Y7QYMZJ53ZAGZ
MAS_GOOGLE_PROVIDER_NAME=Google

# oidc-example is a MAS OAuth client. MAS redirects back to:
#   https://oidc.ess.localhost/callback
MAS_OAUTH_CLIENT_ID=01J44RKQYM4G3TNVANTMTDYTX6
MAS_OAUTH_CLIENT_SECRET=dev-mas-oauth-client-secret-change-me
MAS_OAUTH_SCOPE=openid urn:matrix:org.matrix.msc2967.client:api:*
MAS_PUBLIC_BASE_URL=https://account.ess.localhost
MAS_INTERNAL_BASE_URL=http://ess-matrix-authentication-service:8080
MATRIX_HOMESERVER_INTERNAL_URL=http://ess-synapse-main:8008
